<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PublicidadDinamicaWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PublicidadDinamicaWeb.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-dark navbar-expand-lg bg-dark shadow">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    Publicidad Dinámica
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">

                        @{
                            var rol = Context.Session.GetString("Rol");
                            var comercioId = Context.Session.GetInt32("ComercioId") ?? 0;
                        }

                        @if (rol == ("Operador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Publicidad"
                                   asp-action="Pantalla"
                                   asp-route-comercioId="@comercioId">
                                    Pantalla
                                </a>
                            </li>

                            <li class="nav-item"><a class="nav-link" asp-controller="Configuracion" asp-action="Index">Configuracion</a></li>
                        }

                        @if (rol == "Admin")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Publicidad" asp-action="Pantalla">General</a></li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Publicidad"
                                   asp-action="Pantalla"
                                   asp-route-comercioId="@comercioId">
                                    Pantalla
                                </a>
                            </li>

                            <li class="nav-item"><a class="nav-link" asp-controller="Configuracion" asp-action="Index">Configuracion</a></li>
                        }

                        @if (rol == "Usuario")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Publicidad" asp-action="Pantalla">Pantalla</a></li>

                        }


                        @{
                            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                        }

                        <li class="nav-item">
                            @if (currentController == "Admin" && currentAction == "Index" || currentController == "Operador" && currentAction == "Index" || currentController == "Cliente" && currentAction == "Index")
                            {
                                <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout" onclick="return confirm('¿Estás seguro de que deseas cerrar sesión?')">Cerrar Sesión</a>

                            }
                            else
                            {
                                <a class="nav-link text-primary" asp-controller="Home" asp-action="Index">Volver al Home</a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid text-center">
            &copy; 2026 - PublicidadDinamicaWeb - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>