@model PublicidadDinamicaWeb.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoría";
}

<div style="height:30px;"></div>

<h2 class="mb-3 text-center">Editar Categoría</h2>

<div class="d-flex justify-content-center">
    <div class="card shadow-lg border-0" style="width:400px;">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Editar Categoría</h5>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <input type="hidden" asp-for="IdCategoria" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="NombreCategoria" class="form-label"></label>
                    <input asp-for="NombreCategoria" class="form-control" />
                    <span asp-validation-for="NombreCategoria" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Volver</a>
                    <button type="submit" class="btn btn-success px-4">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}