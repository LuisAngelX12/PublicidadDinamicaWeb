@model PublicidadDinamicaWeb.Models.Categoria

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<h2 class="mb-3 text-center">Eliminar Categoría</h2>

<div class="d-flex justify-content-center">
    <div class="card shadow-lg border-0" style="width:400px;">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Confirmar Eliminación</h5>
        </div>
        <div class="card-body">
            <p>¿Estás seguro que quieres eliminar esta categoría?</p>

            <dl class="row">
                <dt class="col-sm-4">ID</dt>
                <dd class="col-sm-8">@Model.IdCategoria</dd>

                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Model.NombreCategoria</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="IdCategoria" />
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Volver</a>
                    <button type="submit" class="btn btn-danger px-4">Eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>