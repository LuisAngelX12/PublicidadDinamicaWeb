@model PublicidadDinamicaWeb.Models.Categoria

@{
    ViewData["Title"] = "Detalles de Categoría";
}

<div style="height:30px;"></div>

<div class="d-flex justify-content-center align-items-center" style="min-height:80vh;">
    <div class="card shadow-lg border-0" style="width:450px; max-width:90%;">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0 text-center">Detalles de Categoría</h5>
        </div>
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-5">ID</dt>
                <dd class="col-sm-7">@Model.IdCategoria</dd>

                <dt class="col-sm-5">Nombre</dt>
                <dd class="col-sm-7">@Model.NombreCategoria</dd>

                <dt class="col-sm-5"># de Productos</dt>
                <dd class="col-sm-7">@ViewBag.NumProductos</dd>
            </dl>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Edit" asp-route-id="@Model.IdCategoria" class="btn btn-primary">Editar</a>
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </div>
    </div>
</div>