@model PublicidadDinamicaWeb.Models.Comercio

@{
    ViewData["Title"] = "Editar Comercio";
}

<h2 class="mb-3">Editar Comercio</h2>

<div class="d-flex justify-content-center" style="margin-top:30px;">
    <div class="card shadow-lg border-0" style="width:700px; max-width:100%;">

        <!-- HEADER -->
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Edición de Comercio</h5>
            <small class="text-muted">
                Publicidad dinámica
            </small>
        </div>

        <!-- BODY -->
        <div class="card-body">
            <form asp-action="Edit" enctype="multipart/form-data">

                <input type="hidden" asp-for="IdComercio" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <!-- Usuario -->
                    <div class="col-md-6">
                        <label asp-for="IdUsuario" class="form-label"></label>
                        <select asp-for="IdUsuario" asp-items="ViewBag.Usuarios" class="form-select">
                            <option value="">Seleccione un usuario</option>
                        </select>
                        <span asp-validation-for="IdUsuario" class="text-danger"></span>
                    </div>

                    <!-- Nombre -->
                    <div class="col-md-6">
                        <label asp-for="NombreComercio" class="form-label"></label>
                        <input asp-for="NombreComercio" class="form-control" />
                        <span asp-validation-for="NombreComercio" class="text-danger"></span>
                    </div>

                    <!-- Descripción -->
                    <div class="col-md-12">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <!-- Imagen -->
                    <div class="col-md-6">
                        <label class="form-label">Logo del comercio</label>
                        <input type="file" name="imagenFile" id="imagenFileEdit" class="form-control" accept="image/*" />
                        <small class="text-muted">JPG / PNG (opcional)</small>

                        <!-- Preview -->
                        <div class="mt-2 d-flex align-items-center">
                            <img id="previewEdit"
                                 src="@(string.IsNullOrEmpty(Model?.Logo) ? "" : Url.Content($"~/images/comercios/{Model.Logo}"))"
                                 class="img-thumbnail"
                                 style="max-width:120px; max-height:120px; display:@(string.IsNullOrEmpty(Model?.Logo) ? "none" : "block");"
                                 data-original="@(string.IsNullOrEmpty(Model?.Logo) ? "" : Url.Content($"~/images/comercios/{Model.Logo}"))" />

                            <small id="previewLabelEdit"
                                   class="text-muted ms-2"
                                   style="display:@(string.IsNullOrEmpty(Model?.Logo) ? "none" : "block");">
                                @(string.IsNullOrEmpty(Model?.Logo) ? "" : "Imagen actual")
                            </small>

                            <button type="button"
                                    id="removeImageBtn"
                                    class="btn btn-sm btn-danger ms-2"
                                    style="display:@(string.IsNullOrEmpty(Model?.Logo) ? "none" : "inline-block");">
                                Quitar
                            </button>
                        </div>

                        <input type="hidden" name="EliminarImagen" id="EliminarImagen" value="false" />
                    </div>

                    <!-- Estado -->
                    <div class="col-md-12 form-check form-switch mt-2">
                        <input class="form-check-input" asp-for="Estado" />
                        <label class="form-check-label">
                            Comercio activo
                        </label>
                    </div>

                </div>

                <!-- BOTONES -->
                <div class="mt-4 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        Volver
                    </a>
                    <button type="submit" class="btn btn-success px-4">
                        Guardar cambios
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var input = document.getElementById('imagenFileEdit');
            var preview = document.getElementById('previewEdit');
            var previewLabel = document.getElementById('previewLabelEdit');
            var removeBtn = document.getElementById('removeImageBtn');
            var eliminarCampo = document.getElementById('EliminarImagen');

            if (preview && preview.dataset) {
                preview.dataset.original = preview.dataset.original || preview.src || "";
            }

            if (input) {
                input.addEventListener('change', function () {
                    var file = input.files && input.files[0];
                    eliminarCampo.value = "false";

                    if (!file) {
                        if (preview.dataset.original) {
                            preview.src = preview.dataset.original;
                            preview.style.display = 'block';
                            previewLabel.textContent = 'Imagen actual';
                            previewLabel.style.display = 'block';
                            removeBtn.style.display = 'inline-block';
                        } else {
                            preview.style.display = 'none';
                            previewLabel.style.display = 'none';
                            removeBtn.style.display = 'none';
                        }
                        return;
                    }

                    var reader = new FileReader();
                    reader.onload = function (e) {
                        preview.src = e.target.result;
                        preview.style.display = 'block';
                        previewLabel.textContent = 'Vista previa (nuevo)';
                        previewLabel.style.display = 'block';
                        removeBtn.style.display = 'inline-block';
                    };
                    reader.readAsDataURL(file);
                });
            }

            if (removeBtn) {
                removeBtn.addEventListener('click', function () {
                    preview.style.display = 'none';
                    previewLabel.style.display = 'none';
                    input.value = '';
                    eliminarCampo.value = "true";
                    removeBtn.style.display = 'none';
                });
            }
        });
    </script>
}