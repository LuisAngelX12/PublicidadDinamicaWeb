@model PublicidadDinamicaWeb.Models.Comercio

@{
    ViewData["Title"] = "Crear Comercio";
}

<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg p-4" style="width: 450px;">
        <div class="text-center mb-4">
            <h3 class="mb-1">Nuevo Comercio</h3>
            <small class="text-muted">Registro rápido</small>
        </div>

        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Usuario -->
            <div class="mb-3">
                <label asp-for="IdUsuario" class="form-label"></label>
                <select asp-for="IdUsuario" asp-items="ViewBag.Usuarios" class="form-select">
                    <option value="">Seleccione un usuario</option>
                </select>
                <span asp-validation-for="IdUsuario" class="text-danger"></span>
            </div>

            <!-- Nombre Comercio -->
            <div class="mb-3">
                <label asp-for="NombreComercio" class="form-label"></label>
                <input asp-for="NombreComercio" class="form-control" />
                <span asp-validation-for="NombreComercio" class="text-danger"></span>
            </div>

            <!-- Descripción -->
            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <!-- Estado -->
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" asp-for="Estado" />
                <label class="form-check-label">Comercio activo</label>
            </div>

            <!-- Logo -->
            <div class="mb-3">
                <label class="form-label">Imagen del Comercio</label>
                <input type="file" name="imagenFile" class="form-control" accept="image/*" />
            </div>

            <!-- Botones -->
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Volver
                </a>
                <button type="submit" class="btn btn-primary px-4">
                    Guardar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}