@model PublicidadDinamicaWeb.Models.Comercio
@{
    ViewData["Title"] = "Crear Mi Comercio";
}

<div style="height:60px;"></div>

<h2 class="mb-3 text-center">Bienvenido</h2>
<p class="text-center text-muted">
    Antes de comenzar a promocionar productos, necesitas crear tu comercio.
</p>

<div class="d-flex justify-content-center" style="margin-top:30px;">
    <div class="card shadow-lg border-0" style="width:550px; max-width:100%;">

        <div class="card-header bg-dark text-white text-center">
            <h5 class="mb-0">Registro de Comercio</h5>
        </div>

        <div class="card-body">
            <form asp-action="CrearPrimerComercio"
                  asp-controller="Operador"
                  enctype="multipart/form-data">

                <div class="row g-3">

                    <div class="col-md-12">
                        <label asp-for="NombreComercio" class="form-label"></label>
                        <input asp-for="NombreComercio" class="form-control" />
                        <span asp-validation-for="NombreComercio" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Logo</label>
                        <input type="file" name="imagenFile" class="form-control" />
                    </div>

                </div>

                <div class="mt-4">
                    <button type="submit"
                            class="btn btn-success w-100">
                        Crear Comercio
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}