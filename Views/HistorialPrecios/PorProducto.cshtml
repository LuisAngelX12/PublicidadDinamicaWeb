@using PublicidadDinamicaWeb.Helpers
@model IEnumerable<HistorialPrecio>

<div style="height:30px;"></div>

<h2 class="mb-3">Historial de Precios</h2>

<table class="table table-dark table-hover shadow">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Antes</th>
            <th>Ahora</th>
            <th>Estado</th>
            <th>Fecha</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Model)
        {
            <tr>
                <td>@h.Producto.NombreProducto</td>
                <td>₡@String.Format("{0:N2}", h.PrecioAnterior)</td>
                <td>₡@String.Format("{0:N2}", h.PrecioNuevo)</td>
                <td>
                    @if (h.PrecioNuevo > h.PrecioAnterior)
                    {
                        <span class="badge bg-danger">Subió</span>
                    }
                    else if (h.PrecioNuevo < h.PrecioAnterior)
                    {
                        <span class="badge bg-success">Bajó</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Igual</span>
                    }
                </td>
                <td>@FechaHelper.FormatoCR(h.FechaCambio)
            </tr>
        }
    </tbody>
</table>