@model PublicidadDinamicaWeb.Models.Producto

@{
    ViewData["Title"] = "Detalle Producto";
}

<h2 class="mb-3">Detalle del Producto</h2>

<div class="card shadow mb-3">
    <div class="card-body">
        <table class="table table-dark table-hover mb-0">
            <tbody>
                <tr>
                    <th style="width:200px">Comercio</th>
                    <td>@Model.IdComercio</td>
                </tr>
                <tr>
                    <th>Categoría</th>
                    <td>@Model.IdCategoria</td>
                </tr>
                <tr>
                    <th>Nombre</th>
                    <td>@Model.NombreProducto</td>
                </tr>
                <tr>
                    <th>Descripción</th>
                    <td>@Model.Descripcion</td>
                </tr>
                <tr>
                    <th>Precio</th>
                    <td>₡@Model.PrecioActual</td>
                </tr>
                <tr>
                    <th>Imagen</th>
                    <td>@Model.Imagen</td>
                </tr>
                <tr>
                    <th>Estado</th>
                    <td>@Model.Estado</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.IdProducto" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
