@model IEnumerable<PublicidadDinamicaWeb.Models.Producto>

<div style="height:30px;"></div>

<h2 class="mb-3">Productos</h2>

<div class="d-flex justify-content-between mb-3">
    <a class="btn btn-success" asp-action="Create">Nuevo Producto</a>

    <div class="d-flex gap-2">
        <input type="text" id="searchInput" class="form-control" placeholder="Buscar producto..." />
        <select id="filterVariacion" class="form-select">
            <option value="">Todos</option>
            <option value="Subió">Subió</option>
            <option value="Bajó">Bajó</option>
            <option value="Sin cambio">Sin cambio</option>
        </select>
    </div>
</div>

<table class="table table-dark table-hover shadow" id="productosTable">
    <thead>
        <tr>
            <th>Imagen</th>
            <th>Producto</th>
            <th>Precio Actual</th>
            <th>Variación</th>
            <th>Último Cambio</th>
            <th>Descripcion</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var ultimo = item.HistorialPrecios?
                .OrderByDescending(h => h.FechaCambio)
                .FirstOrDefault();

            string variacion = "Sin cambio";
            string badgeClass = "bg-secondary"; // gris para sin cambio

            if (ultimo != null)
            {
                if (ultimo.PrecioNuevo > ultimo.PrecioAnterior)
                {
                    variacion = "Subió";
                    badgeClass = "bg-danger"; // rojo
                }
                else if (ultimo.PrecioNuevo < ultimo.PrecioAnterior)
                {
                    variacion = "Bajó";
                    badgeClass = "bg-success"; // verde
                }
            }

            <tr data-variacion="@variacion.ToLower()">
                <td class="text-center">
                    @{
                        var rutaImagen = !string.IsNullOrEmpty(item.Imagen)
                            ? Url.Content("~/images/productos/" + item.Imagen)
                            : Url.Content("~/images/productos/placeholder.jpg");
                    }

                    <img src="@rutaImagen"
                         alt="@item.NombreProducto"
                         style="width:70px; height:70px; object-fit:cover; cursor:pointer; border-radius:4px;"
                         onclick="abrirImagenModal('@rutaImagen', '@item.NombreProducto')" />
                </td>

                <td>@item.NombreProducto</td>
                <td>₡@String.Format("{0:N2}", item.PrecioActual)</td>
                <td>
                    <span class="badge @badgeClass">@variacion</span>
                </td>
                <td>
                    @(ultimo != null
                        ? "₡" + String.Format("{0:N2}", ultimo.PrecioAnterior)
                        : "N/A")
                </td>

                <td>@item.Descripcion</td>

                <td>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.IdProducto">Editar</a>
                    <a class="btn btn-sm btn-info"
                       asp-controller="HistorialPrecios"
                       asp-action="PorProducto"
                       asp-route-id="@item.IdProducto">
                        Historial
                    </a>

                    <form asp-action="Delete" asp-route-id="@item.IdProducto" method="post" class="d-inline"
                          onsubmit="return confirm('¿Estás seguro que quieres borrar este producto?');">
                        <button type="submit" class="btn btn-sm btn-danger">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal para mostrar la imagen grande -->
<div class="modal fade" id="imagenModal" tabindex="-1" aria-labelledby="imagenModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header">
                <h5 class="modal-title" id="imagenModalLabel">Imagen del Producto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center">
                <img id="imagenGrande" src="" alt="Producto" class="img-fluid" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('searchInput');
        const filterSelect = document.getElementById('filterVariacion');
        const table = document.getElementById('productosTable');
        const rows = table.querySelectorAll('tbody tr');

        function filterTable() {
            const searchText = searchInput.value.toLowerCase();
            const filter = filterSelect.value.toLowerCase();

            rows.forEach(row => {
                const productName = row.cells[1].textContent.toLowerCase();  // Nombre del producto
                const productDescription = row.cells[5].textContent.toLowerCase();  // Descripción
                const variacion = row.dataset.variacion;

                // Comprobamos si el nombre del producto o la descripción coinciden con el texto de búsqueda
                const matchesSearch = productName.includes(searchText) || productDescription.includes(searchText);
                const matchesFilter = !filter || variacion === filter;

                row.style.display = (matchesSearch && matchesFilter) ? '' : 'none';
            });
        }

        searchInput.addEventListener('input', filterTable);
        filterSelect.addEventListener('change', filterTable);
    </script>
}