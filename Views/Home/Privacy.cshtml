@{
    ViewData["Title"] = "Información Legal";
}

<!-- Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
    .legal-section {
        padding: 60px 0;
        color: #f8f9fa;
    }

    .legal-card {
        background-color: #212529;
        border: none;
        border-radius: 15px;
        padding: 35px;
        transition: all 0.3s ease;
        height: 100%;
        box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    }

        .legal-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.6);
        }

        .legal-card h2 {
            font-weight: 600;
            margin-bottom: 20px;
        }

        .legal-card i {
            font-size: 2rem;
            color: #0d6efd;
            margin-bottom: 15px;
        }

        .legal-card ul {
            padding-left: 20px;
        }

        .legal-card li {
            margin-bottom: 8px;
        }

    .legal-footer {
        margin-top: 40px;
        font-size: 0.9rem;
        color: #adb5bd;
        border-top: 1px solid #495057;
        padding-top: 15px;
        text-align: center;
    }
</style>

<section class="legal-section">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="fw-bold">Información Legal y Corporativa</h1>
            <p class="text-secondary">Transparencia, seguridad y compromiso con nuestros usuarios.</p>
        </div>

        <div class="row g-4">

            <!-- POLÍTICA DE PRIVACIDAD -->
            <div class="col-lg-6">
                <div class="legal-card">
                    <div class="text-center">
                        <i class="bi bi-shield-lock-fill"></i>
                        <h2>Política de Privacidad</h2>
                    </div>

                    <p>
                        En <strong>Publicidad Dinámica Web</strong>, protegemos tu información con los más altos
                        estándares de seguridad. Nuestra prioridad es garantizar confidencialidad,
                        integridad y transparencia en el manejo de datos.
                    </p>

                    <h5 class="mt-4"><i class="bi bi-database-fill"></i> Información Recopilada</h5>
                    <ul>
                        <li>Datos de registro (nombre, correo y contraseña cifrada).</li>
                        <li>Información de comercios y productos publicados.</li>
                        <li>Datos técnicos como IP y tipo de navegador.</li>
                    </ul>

                    <h5 class="mt-4"><i class="bi bi-gear-fill"></i> Uso de la Información</h5>
                    <ul>
                        <li>Gestión y administración de cuentas.</li>
                        <li>Optimización de la experiencia del usuario.</li>
                        <li>Seguridad y prevención de accesos no autorizados.</li>
                    </ul>

                    <h5 class="mt-4"><i class="bi bi-person-check-fill"></i> Derechos del Usuario</h5>
                    <ul>
                        <li>Acceso, corrección o eliminación de datos.</li>
                        <li>Cancelación de cuenta en cualquier momento.</li>
                        <li>Control sobre el uso de cookies.</li>
                    </ul>

                    <div class="legal-footer">
                        Última actualización: @DateTime.UtcNow.ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>

            <!-- SOBRE NOSOTROS -->
            <div class="col-lg-6">
                <div class="legal-card">
                    <div class="text-center">
                        <i class="bi bi-building-fill"></i>
                        <h2>Sobre Nosotros</h2>
                    </div>

                    <p>
                        <strong>Publicidad Dinámica Web</strong> es una plataforma tecnológica
                        creada para impulsar la digitalización de pequeños y medianos negocios.
                        Facilitamos herramientas modernas que permiten gestionar y promocionar
                        productos de forma eficiente y profesional.
                    </p>

                    <h5 class="mt-4"><i class="bi bi-bullseye"></i> Nuestra Misión</h5>
                    <p>
                        Brindar soluciones digitales accesibles que potencien la visibilidad
                        y competitividad de los comercios en el entorno online.
                    </p>

                    <h5 class="mt-4"><i class="bi bi-stars"></i> Qué Ofrecemos</h5>
                    <ul>
                        <li>Gestión integral de comercios.</li>
                        <li>Publicación y administración de productos.</li>
                        <li>Subida de imágenes personalizada.</li>
                        <li>Interfaz moderna, adaptable y fácil de usar.</li>
                    </ul>

                    <h5 class="mt-4"><i class="bi bi-eye-fill"></i> Nuestra Visión</h5>
                    <p>
                        Convertirnos en una plataforma líder en soluciones digitales
                        para negocios que buscan crecer en el mundo online.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>