@model PublicidadDinamicaWeb.Models.Comercio

@{
    ViewData["Title"] = Model.NombreComercio;
}

<div style="height:30px;"></div>

<h2>@Model.NombreComercio</h2>
<p>@Model.Descripcion</p>

<div class="row mt-4">
    @foreach (var producto in Model.Productos)
    {
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-img-container">
                    <img src="@producto.Imagen" alt="@producto.NombreProducto" />
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@producto.NombreProducto</h5>
                    <p class="card-text flex-grow-1">@producto.Descripcion</p>
                    <p class="text-success fw-bold">$@producto.PrecioActual.ToString("N2")</p>
                    <a href="@Url.Action("DetallesProducto", "Cliente", new { id = producto.IdProducto })" class="btn btn-outline-primary btn-sm mt-auto">Detalles</a>
                </div>
            </div>
        </div>
    }
</div>