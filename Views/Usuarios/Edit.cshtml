@model PublicidadDinamicaWeb.Models.Usuario

<div style="height:30px;"></div>

<h2 class="mb-4 text-center">Administrar Usuario</h2>

<div class="d-flex justify-content-center">
    <div class="card bg-dark text-white shadow p-4"
         style="width:450px; min-width:320px;">

        <form asp-action="Edit">
            <input type="hidden" asp-for="IdUsuario" />

            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input class="form-control" value="@Model.Nombre" disabled />
            </div>

            <div class="mb-3">
                <label class="form-label">Correo</label>
                <input class="form-control" value="@Model.Correo" disabled />
            </div>

            <!-- Estado -->
            <div class="form-check form-switch mb-3">
                <input asp-for="Estado" class="form-check-input" />
                <label asp-for="Estado" class="form-check-label">
                    @(Model.Estado ? "Cuenta Activa" : "Cuenta Inactiva")
                </label>
            </div>

            <!-- Rol -->
            <div class="mb-4">
                <label class="form-label">Rol</label>
                <select name="IdRol" class="form-select" asp-items="ViewBag.Roles"></select>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
                <button type="submit" class="btn btn-warning">
                    Guardar Cambios
                </button>
            </div>

        </form>
    </div>
</div>