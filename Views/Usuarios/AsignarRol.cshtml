@model PublicidadDinamicaWeb.Models.Usuario

<div style="height:30px;"></div>

<h2 class="mb-4 text-center">Asignar Rol de Usuario</h2>

<div class="d-flex justify-content-center">
    <div class="card bg-dark text-white shadow p-4"
         style="width:450px; min-width:320px;">

        <form asp-action="AsignarRol" method="post">
            <input type="hidden" asp-for="IdUsuario" />

            <!-- Nombre -->
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input class="form-control" value="@Model.Nombre" disabled />
            </div>

            <!-- Correo -->
            <div class="mb-3">
                <label class="form-label">Correo</label>
                <input class="form-control" value="@Model.Correo" disabled />
            </div>

            

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
                <button type="submit" class="btn btn-warning">
                    Guardar Cambios
                </button>
            </div>

        </form>
    </div>
</div>