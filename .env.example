# .env.example - Plantilla de variables de entorno
# Copia este archivo a ".env" y rellena los valores reales.

# ========================================
# BASE DE DATOS (PostgreSQL)
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mi_base_de_datos
DB_USER=mi_usuario
DB_PASSWORD=mi_contraseña_segura

# ========================================
# SEED - USUARIOS INICIALES
# ========================================
ADMIN_EMAIL=admin@ejemplo.com	// Cualquier correo y contraseña segura para el usuario administrador
ADMIN_PASSWORD=Admin123!

PANTALLA_EMAIL=pantalla@ejemplo.com	// Cualquier correo y contraseña segura para el usuario pantalla
PANTALLA_PASSWORD=Pantalla123!

# NOTAS:
# - Sustituye los valores por los de tu entorno local/producción.
# - Mantén el archivo .env fuera del control de versiones (añádelo a .gitignore).
